      "title": "EN",
      "properties": {},
      "widgets_values": [
        "# Qwen3-TTS-0.6/1.7 Fine-Tuning\n- audio_folder: Path to audio dataset\n- output_dir: Path to save fine-tuned model\n- speaker_name: Speaker name (similar to built-in voices like custom_voice)\n- test_text: Sample audio text content (currently not implemented for training samples)\n- learning_rate: Learning rate, recommended 2e-5/2e-6\n- num_epochs: Number of training epochs\n- batch_size: Default 1 (16G test may cause OOM)\n- gradient_accumulation_steps: Gradient accumulation, trading time for space\n- validate_every: Validation frequency, saving model and generating test audio every X epochs (currently not implemented)"
      ],
      "color": "#432",
      "bgcolor": "#653"
    },
    {
      "id": 4,
      "type": "MarkdownNote",
      "pos": [
        390,
        -3580
      ],
      "size": [
        420,
        220
      ],
      "flags": {
        "pinned": true
      },
      "order": 2,
      "mode": 0,
      "inputs": [],
      "outputs": [],
      "title": "ZH",
      "properties": {},
      "widgets_values": [
        "# Qwen3-TTS-0.6/1.7 Fine-Tuning\n- audio_folder: path to the audio dataset\n- output_dir: where the fine-tuned model is saved\n- speaker_name: speaker name (works like the built-in custom_voice speakers)\n- test_text: text for the sample audio (sampling during training is not implemented yet)\n- learning_rate: learning rate, 2e-5/2e-6 recommended\n- num_epochs: number of training epochs\n- batch_size: default 1 (2 runs out of memory on 16 GB)\n- gradient_accumulation_steps: gradient accumulation, trades time for memory\n- validate_every: validation frequency, i.e. save the model and generate a test audio every N epochs (not implemented yet)"
      ],
      "color": "#432",
      "bgcolor": "#653"
    },
